--- orig/core/kv_cache_utils.py
+++ tree/core/kv_cache_utils.py
@@ -328,0 +329,26 @@
+    def prepend_n(self, blocks: list[KVCacheBlock]) -> None:
+        """Put a list of blocks at the front of the free list.
+
+        Backport of upstream vLLM #43447 (PLAT-4203): freeing a request splits
+        its blocks so uncached scratch blocks are prepended (reused first) while
+        cached prefix blocks are appended (retained longest for a future hit).
+        """
+        if len(blocks) == 0:
+            return
+
+        first_block = self.fake_free_list_head.next_free_block
+        assert first_block is not None, (
+            "next_free_block of fake_free_list_head should always exist"
+        )
+
+        prev_block = self.fake_free_list_head
+        for block in blocks:
+            block.prev_free_block = prev_block
+            prev_block.next_free_block = block
+            prev_block = block
+
+        prev_block.next_free_block = first_block
+        first_block.prev_free_block = prev_block
+
+        self.num_free_blocks += len(blocks)
+
